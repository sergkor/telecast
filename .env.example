# TELECAST_TIKTOK_CLIENT_KEY=  # from your TikTok developer app
# TELECAST_TIKTOK_CLIENT_SECRET=
# TELECAST_TIKTOK_PRIVACY=SELF_ONLY  # PUBLIC_TO_EVERYONE once the app passes TikTok audit
# TELECAST_PINTEREST_APP_ID=  # from your Pinterest developer app
# TELECAST_PINTEREST_APP_SECRET=
# TELECAST_PINTEREST_BOARD_ID=  # board the pins are published to
