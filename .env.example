# TELECAST_ENHANCE_MODEL=gemini-flash-latest  # pro models need a paid-tier API key
# TELECAST_RECENT_POSTS=5  # video posts per channel ingested on startup
# TELECAST_PUBLISH_DELAY_MINUTES=5  # wait before the first queued publish
